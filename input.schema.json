{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecretGiverConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["givers", "recipients"],
  "properties": {
    "givers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "excludes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "excludes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}